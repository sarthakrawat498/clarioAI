PROJECT_NAME="ClarioAI"
API_V1_STR="/api/v1"

# SECURITY: Set this to a strong random value in production
# For development, it will auto-default if not provided and ENVIRONMENT is not 'production'
# SECRET_KEY="your-strong-secret-key-here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200
ENVIRONMENT="development"

# CORS Configuration: JSON list of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Demo Mode: Set to true to allow unauthenticated access via demo account
ENABLE_DEMO_MODE=false
DEMO_USER_EMAIL="demo@clario.ai"
DEMO_USER_PASSWORD="demo123456"

# Database Configuration (Supports SQLite local, Azure SQL, PostgreSQL)
DATABASE_URL="sqlite:///./health_insurance.db"

# OpenAI LLM Configuration
OPENAI_API_KEY=""
LLM_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"

# Vector Store Path
CHROMA_DB_DIR="./data/chromadb"

# Environment
ENVIRONMENT="development"
LOG_LEVEL="INFO"
