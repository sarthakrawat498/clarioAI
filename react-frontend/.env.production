# Production Vite environment variables for React frontend
# These should be updated during deployment based on your production server

# API Base URL for backend communication - UPDATE THIS FOR YOUR PRODUCTION DOMAIN
VITE_API_BASE_URL=/api/v1

# Using relative /api/v1 path allows the frontend to work with:
# 1. Same-origin API (recommended): Frontend at https://example.com, API at https://example.com/api/v1
# 2. Reverse proxy: Frontend at https://example.com, proxy forwards /api/* to backend

# App environment
VITE_APP_ENV=production

# Application name
VITE_APP_NAME=ClarioAI
